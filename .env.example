DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=invoice_financing

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

REDIS_HOST=localhost
REDIS_PORT=6379

# Cron pattern for the daily due-date settlement scan (BullMQ repeatable job)
SETTLEMENT_SCAN_CRON=0 0 * * *

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per IP.
# Individual routes (e.g. auth/login) set a tighter limit of their own.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

PORT=3000
